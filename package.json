{
  "name": "warden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate-assets": "node scripts/generate-assets.cjs",
    "build-tiles": "node scripts/build-tiles.cjs",
    "bake-depth": "node scripts/bake-depth.cjs",
    "test-shade": "node scripts/test-shade.mjs",
    "regenerate-tiles": "node scripts/regenerate-tiles.cjs",
    "migrate-tiles": "node scripts/migrate-tiles.cjs",
    "new-room": "node scripts/new-room.cjs",
    "create-room-tiles": "node scripts/create-room-tiles.cjs",
    "patch-tilemaps": "node scripts/patch-tilemaps.cjs",
    "build-tileset": "node scripts/build-tileset.cjs",
    "export-tiles": "node scripts/export-tiles.cjs",
    "extract-tile": "node scripts/extract-tile.cjs",
    "put-tile": "node scripts/put-tile.cjs",
