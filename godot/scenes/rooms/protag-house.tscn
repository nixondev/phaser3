position = Vector2(1309, 212)
texture = ExtResource("6_8d0d1")
region_enabled = true
region_rect = Rect2(448, 0, 64, 64)
script = ExtResource("7_gwt3u")
interact_id = "controls-hint"
kind = "sign"
text = "Flashlight: Pick it up, press 'F' to toggle.
Battery: Refill at chargers or with fuel.
Drop it (Q) and another can use it.
It keeps the afflicted at bay.
Direct the beam — they react to light.
A moving cone is harder for them to track.
Stay near walls when the battery is low.
Keep moving. Standing still gets you cornered.
Recharge stations are marked in each building.
The charger in this room still works."

