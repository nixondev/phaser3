        {
          "id": "street-wanderer-1",
          "name": "Kai",
          "role": "Former Lab Technician",
          "x": 1600,
          "y": 2000,
          "behaviorLoop": "wander",
          "variant": "walker",
          "playerVariant": "ranger",
          "associatedRoom": "house-b",
          "curedClue": "...they look up and mumble something about the north block... the smell of chemicals... a lab coat...",
          "backstory": [
            "Kai — Former Lab Technician\n\"I remember now. The city sealed overnight.\nWe were mid-experiment.\"",
            "\"Whatever you used... it worked. I've been\nlooping for weeks. Trapped in that corner.\"\n\n\"I know this city's systems. I want out too.\"",
            "\"Tell me what you need. I'll help.\"\n\n[Kai hands you a Lab Keycard and a Compound Sample.]\n[Kai joins your cause. They are waiting for you at Apartment 4B.]"
          ],
          "recoveredItems": [
            {
              "name": "Lab Keycard",
              "tileFrame": 8,
              "category": "key",
              "keyId": "lab-door"
            },
            {
              "name": "Compound Sample",
              "tileFrame": 9,
              "category": "cure"
            }
          ]
        },
        {
          "id": "street-wanderer-2",
          "name": "Maren",
          "role": "Local Shopkeeper",
          "x": 4000,
          "y": 2800,
          "behaviorLoop": "wander",
          "variant": "walker",
          "playerVariant": "rogue",
          "associatedRoom": "house-c",
          "curedClue": "...they whisper about the community room... counting shelves... the logbook...",
          "backstory": [
            "Maren — Local Shopkeeper\n\"The community room. That's where I kept\nthe last of the supplies. I know what's left.\"",
            "\"I've been walking the same block\nfor... I don't know how long. Thank you.\"\n\n\"Take what you need from what I have.\"",
            "\"I'll help you map what's still usable\nin here. There's more to this city\nthan anyone told us.\"\n\n[Maren joins your cause. They are waiting for you at the Community Room.]"
          ],
          "recoveredItems": [
            {
              "name": "Store Key",
              "tileFrame": 8,
              "category": "key",
              "keyId": "store-front"
            },
            {
              "name": "Supply Manifest",
              "tileFrame": 7,
              "category": "document",
              "content": "Hand-written stock count.\nSection 3 still sealed.\nGenerator fuel: 4 cans — basement, east wall.\nNote: don't trust the east corridor after dark."
            }
          ]
        }
      ],
