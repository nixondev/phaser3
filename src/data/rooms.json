        {
          "id": "street-wanderer-2",
          "name": "Maren",
          "role": "Local Shopkeeper",
          "x": 4000,
          "y": 2800,
          "behaviorLoop": "wander",
          "variant": "walker",
          "playerVariant": "rogue",
          "associatedRoom": "house-c",
          "curedClue": "...they whisper about the community room... counting shelves... the logbook...",
          "backstory": [
            "Maren — Local Shopkeeper\n\"The community room. That's where I kept\nthe last of the supplies. I know what's left.\"",
            "\"I've been walking the same block\nfor... I don't know how long. Thank you.\"\n\n\"Take what you need from what I have.\"",
            "\"I'll help you map what's still usable\nin here. There's more to this city\nthan anyone told us.\"\n\n[Maren joins your cause. They are waiting for you at the Community Room.]"
          ],
          "recoveredItems": [
